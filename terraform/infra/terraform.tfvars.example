# Copy to terraform.tfvars (not committed) and fill in.
region       = "ap-south-1"
project      = "marathon"
admin_cidr   = "203.0.113.10/32"       # curl -s https://checkip.amazonaws.com, then add /32
budget_email = "you@example.com"

